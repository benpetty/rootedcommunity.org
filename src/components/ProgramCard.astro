---
import { urlFor } from "../lib/image";
import type { ProgramSummary } from "../lib/sanity";

interface Props {
  program: ProgramSummary;
  headingLevel?: 2 | 3;
}

const { program, headingLevel = 3 } = Astro.props;
const HeadingTag = `h${headingLevel}` as const;
const href = `/programs/${program.slug.current}/`;
const imageSrc = program.heroImage?.asset
  ? urlFor( program.heroImage ).width( 800 ).height( 600 ).format( "webp" ).url()
  : null;
---

<a class="program-card fade-in" href={href}>
  <div class="program-card__image-wrap">
    {imageSrc
      ? <img src={imageSrc} alt={program.heroImage?.alt ?? ""} width="800" height="600" loading="lazy" decoding="async" />
      : <div class="program-card__image-placeholder" aria-hidden="true"></div>
    }
  </div>
  <div class="program-card__body">
    <HeadingTag class="program-card__name">{program.name}</HeadingTag>
    {program.summary && <p class="program-card__summary">{program.summary}</p>}
    <span class="program-card__more">Read more <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .program-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var( --color-bg );
    border: 1px solid var( --color-rule );
    transition: border-color 150ms ease, transform 250ms ease;
  }

  .program-card:hover {
    border-color: var( --color-forest );
    transform: translateY( -2px );
  }

  .program-card__image-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var( --color-surface );
  }

  .program-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate( 0.9 );
    transition: transform 600ms ease;
  }

  .program-card:hover .program-card__image-wrap img {
    transform: scale( 1.03 );
  }

  .program-card__image-placeholder {
    height: 100%;
    background: linear-gradient( 135deg, var( --color-surface ), var( --color-rule ) );
  }

  .program-card__body {
    padding: var( --space-5 ) var( --space-5 ) var( --space-6 );
    display: flex;
    flex-direction: column;
    gap: var( --space-3 );
    flex: 1;
  }

  .program-card__name {
    font-size: var( --text-xl );
    font-weight: 480;
    margin: 0;
  }

  .program-card__summary {
    color: var( --color-muted );
    font-size: var( --text-sm );
    line-height: var( --line-snug );
    margin: 0;
  }

  .program-card__more {
    margin-top: auto;
    font-family: var( --font-body );
    font-size: var( --text-xs );
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var( --color-forest );
  }
</style>
