---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ImpactStat from "../components/ImpactStat.astro";
import ProgramCard from "../components/ProgramCard.astro";
import PartnerLogo from "../components/PartnerLogo.astro";
import {
  getHomePage,
  getFeaturedPrograms,
  getPrograms,
  getFeaturedPartners,
} from "../lib/sanity";

const home = await getHomePage();
const featuredPrograms = await getFeaturedPrograms();
const programs = featuredPrograms.length > 0 ? featuredPrograms : await getPrograms();
const partners = await getFeaturedPartners();

const stat = home?.featuredImpactStat;
---

<Layout title="Rooted Community" description={home?.heroSubhead}>
  <Hero
    eyebrow={home?.heroEyebrow}
    headline={home?.heroHeadline}
    subhead={home?.heroSubhead}
    image={home?.heroImage}
    ctaPrimary={home?.ctaPrimary}
    ctaSecondary={home?.ctaSecondary}
  />

  {stat?.value && stat?.label && (
    <section class="container section section--stat">
      <div class="prose fade-in">
        <p class="eyebrow">Our impact, this year</p>
        <ImpactStat value={stat.value} label={stat.label} size="large" />
        <a href="/impact/" class="button">See more impact</a>
      </div>
    </section>
  )}

  {programs.length > 0 && (
    <section class="container section">
      <header class="section-head fade-in">
        <p class="eyebrow">What we do</p>
        <h2>Seven programs, one community.</h2>
        <p class="muted prose">
          Each program meets community members at a different point of the reentry and healing journey.
        </p>
      </header>
      <div class="programs-grid">
        {programs.map( program => <ProgramCard program={program} /> )}
      </div>
      <div class="section-foot">
        <a href="/programs/" class="button">All programs</a>
      </div>
    </section>
  )}

  {partners.length > 0 && (
    <section class="container section">
      <header class="section-head fade-in">
        <p class="eyebrow">{home?.partnersIntro ?? "In community with"}</p>
        <h2>Partners and supporters.</h2>
      </header>
      <div class="partners-strip fade-in">
        {partners.map( partner => <PartnerLogo partner={partner} /> )}
      </div>
      <div class="section-foot">
        <a href="/partners/" class="button">All partners</a>
      </div>
    </section>
  )}
</Layout>

<style>
  .section--stat .prose { display: flex; flex-direction: column; gap: var( --space-5 ); align-items: flex-start; }

  .section-head {
    max-width: var( --prose-width );
    margin-bottom: var( --space-8 );
    display: flex;
    flex-direction: column;
    gap: var( --space-3 );
  }

  .section-head h2 { margin: var( --space-2 ) 0 0; }

  .section-foot {
    margin-top: var( --space-7 );
    display: flex;
    justify-content: flex-start;
  }

  .programs-grid {
    display: grid;
    gap: var( --space-5 );
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .programs-grid { grid-template-columns: repeat( 2, 1fr ); }
  }

  @media (min-width: 960px) {
    .programs-grid { grid-template-columns: repeat( 3, 1fr ); }
  }

  .partners-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var( --space-6 ) var( --space-7 );
    align-items: center;
    justify-content: flex-start;
    padding-top: var( --space-5 );
    border-top: 1px solid var( --color-rule );
  }
</style>
