---
import Layout from "../layouts/Layout.astro";
import PortableText from "../components/PortableText.astro";
import { getMissionPage } from "../lib/sanity";

const page = await getMissionPage();
const title = page?.pageTitle ?? "Our Mission";
const pageDescription = page?.pageDescription ?? page?.mission;
---

<Layout title={`${title} — Rooted Community`} description={pageDescription}>
  <section class="container section">
    <p class="eyebrow">Rooted Community</p>
    <h1 class="page-title">{title}</h1>
  </section>

  {page?.mission && (
    <section class="container section section--mission">
      <p class="eyebrow">Mission</p>
      <p class="lede serif">{page.mission}</p>
    </section>
  )}

  {page?.vision && (
    <section class="container section">
      <p class="eyebrow">Vision</p>
      <p class="lede serif">{page.vision}</p>
    </section>
  )}

  {page?.originStory && (
    <section class="container section">
      <p class="eyebrow">Origin</p>
      <div class="prose"><PortableText value={page.originStory} /></div>
    </section>
  )}

  {( page?.theoryOfChange?.problem || page?.theoryOfChange?.approach || page?.theoryOfChange?.outcome ) && (
    <section class="container section">
      <p class="eyebrow">Theory of Change</p>
      <div class="theory-grid">
        {page?.theoryOfChange?.problem && (
          <div class="theory-grid__cell fade-in">
            <h2>Problem</h2>
            <PortableText value={page.theoryOfChange.problem} />
          </div>
        )}
        {page?.theoryOfChange?.approach && (
          <div class="theory-grid__cell fade-in">
            <h2>Approach</h2>
            <PortableText value={page.theoryOfChange.approach} />
          </div>
        )}
        {page?.theoryOfChange?.outcome && (
          <div class="theory-grid__cell fade-in">
            <h2>Outcome</h2>
            <PortableText value={page.theoryOfChange.outcome} />
          </div>
        )}
      </div>
    </section>
  )}

  {page?.pullQuote?.quote && (
    <section class="container section">
      <blockquote>
        {page.pullQuote.quote}
        {page.pullQuote.attribution && <footer class="pull-quote-attribution">— {page.pullQuote.attribution}</footer>}
      </blockquote>
    </section>
  )}
</Layout>

<style>
  .page-title {
    font-size: clamp( 2.75rem, 6vw, 5rem );
    line-height: 1.05;
    letter-spacing: -0.018em;
    margin-top: var( --space-3 );
    max-width: 24ch;
  }

  .lede.serif {
    font-size: clamp( 1.375rem, 2.5vw, 1.75rem );
    line-height: var( --line-snug );
    max-width: 36rem;
    margin-top: var( --space-3 );
  }

  .section--mission { background: var( --color-surface ); }

  .theory-grid {
    margin-top: var( --space-5 );
    display: grid;
    gap: var( --space-6 );
  }

  @media (min-width: 880px) {
    .theory-grid { grid-template-columns: repeat( 3, 1fr ); }
  }

  .theory-grid__cell h2 {
    font-family: var( --font-body );
    font-size: var( --text-xs );
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var( --color-forest );
    margin-bottom: var( --space-3 );
  }

  .pull-quote-attribution {
    display: block;
    margin-top: var( --space-3 );
    font-style: normal;
    font-family: var( --font-body );
    font-size: var( --text-sm );
    color: var( --color-muted );
    letter-spacing: 0.04em;
  }
</style>
